INSERT INTO medico_specializzazione
(id_medico, id_specializzazione)
SELECT m.id_medico, s.id_specializzazione
FROM medico m
JOIN utente u ON u.id_utente = m.id_medico
JOIN specializzazione s
    ON s.nome IN ('Radiologia', 'Diagnostica per immagini')
WHERE u.email = 'andreaverdi@medpiox.it';


